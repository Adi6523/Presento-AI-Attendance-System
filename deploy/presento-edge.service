[Unit]
Description=Presento Raspberry Pi edge attendance
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/presento
EnvironmentFile=/home/pi/presento/.env
ExecStart=/home/pi/presento/.venv/bin/python -m edge.runner
Restart=always
RestartSec=5

# Graceful shutdown: send SIGTERM, wait 10s, then SIGKILL
TimeoutStopSec=10
KillSignal=SIGTERM

# Limit resource usage (safety net)
MemoryMax=900M
CPUQuota=90%

# Logging: redirect to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=presento-edge

[Install]
WantedBy=multi-user.target
