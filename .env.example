# ==============================================================================
# Presento Configuration
# ==============================================================================

# ── Camera Configuration ──────────────────────────────────────────────────────
# 'webcam': Built-in laptop webcam or USB camera (Recommended for Friends / Testing)
# 'stream': Raspberry Pi TCP camera stream (Hardware deployment)
CAMERA_SOURCE=webcam
CAMERA_INDEX=0

# 'AUTO': Automatically inspects hardware and uses Intel GPU if verified, or CPU for AMD/NVIDIA/standard CPUs
# 'CPU': Force CPU inference universally across all platforms
# 'GPU': Force GPU inference (Intel only)
OPENVINO_DEVICE=AUTO

# ── Recognition & Anti-Spoof Parameters ───────────────────────────────────────
MATCH_TOLERANCE=0.48
COOLDOWN_SECONDS=10.0
USE_FACE_TRACKING=true

# ── API & Local Backend Settings ──────────────────────────────────────────────
DEVICE_ID=laptop-client
API_URL=http://127.0.0.1:8000
API_TOKEN=change-me-before-production
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/presento.db
ATTENDANCE_MIN_CONFIDENCE=0.48
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# AI Vision engine API key — used by edge/backend_client.py to authenticate with POST /api/attendance/events.
# Must match PRESENTO_AI_API_KEY in the backend .env.
PRESENTO_AI_API_KEY=change-me-before-production-ai-key

# ── Raspberry Pi Deployment Settings (Only used when CAMERA_SOURCE=stream) ─────
PI_IP=presento-pi.local
PRESENTO_STREAM_PORT=5001
PRESENTO_CONTROL_PORT=5002
PRESENTO_CONTROL_TOKEN=change-me-before-production
HEADLESS=false
ROOM=A101
PIR_PIN=17
BUZZER_PIN=18

# ── Optional Cloud Integrations (Never commit real credentials) ───────────────
SUPABASE_URL=
SUPABASE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
